<Window x:Class="Cursavayaup1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Платформа пожертвований"
        Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgPrimary}"
        FontFamily="{DynamicResource AppFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Меню -->
        <Border Grid.Column="0" Background="{DynamicResource BgMenu}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="15,20,15,20">
                    <TextBlock x:Name="txtUserName" Text="Пользователь"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextOnDark}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="txtUserRole" Text="Роль"
                               FontSize="12" Foreground="#B0C4DE" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="0,10,0,0">
                    <Button Content="Все кампании" Style="{StaticResource MenuButton}" Click="BtnCampaigns_Click"/>
                    <Button Content="Создать кампанию" Style="{StaticResource MenuButton}" Click="BtnCreateCampaign_Click"/>
                    <Button Content="Мои пожертвования" Style="{StaticResource MenuButton}" Click="BtnMyDonations_Click"/>
                    <Button Content="Мои кампании" Style="{StaticResource MenuButton}" Click="BtnMyCampaigns_Click"/>
                    <Button Content="Профиль" Style="{StaticResource MenuButton}" Click="BtnProfile_Click"/>
                    <Button x:Name="btnAdmin" Content="Админ-панель" Style="{StaticResource MenuButton}"
                            Click="BtnAdmin_Click" Visibility="Collapsed"/>
                    <Button x:Name="btnTheme" Content="Тёмная тема" Style="{StaticResource MenuButton}"
                            Click="BtnTheme_Click"/>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Content="Выйти" Style="{StaticResource MenuButton}"
                        Margin="0,0,0,15" Click="BtnLogout_Click"/>
            </DockPanel>
        </Border>

        <!-- Контент -->
        <Grid Grid.Column="1" Background="{DynamicResource BgSecondary}">
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>