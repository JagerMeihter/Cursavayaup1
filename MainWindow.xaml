<Window x:Class="Cursavayaup1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Платформа пожертвований" 
        Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Левое меню ===== -->
        <Border Grid.Column="0" Background="#2C3E50">
            <DockPanel>
                <!-- Информация о пользователе -->
                <StackPanel DockPanel.Dock="Top" Margin="15,20,15,20">
                    <TextBlock x:Name="txtUserName" 
                               Text="Пользователь" 
                               FontSize="16" FontWeight="SemiBold" 
                               Foreground="White" TextWrapping="Wrap"/>
                    <TextBlock x:Name="txtUserRole" 
                               Text="Роль" 
                               FontSize="12" 
                               Foreground="#BDC3C7" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Кнопки меню -->
                <StackPanel DockPanel.Dock="Top" Margin="0,10,0,0">
                    <Button Content="Все кампании" Style="{StaticResource MenuButton}" 
                            Click="BtnCampaigns_Click"/>
                    <Button Content="Создать кампанию" Style="{StaticResource MenuButton}" 
                            Click="BtnCreateCampaign_Click"/>
                    <Button Content="Мои пожертвования" Style="{StaticResource MenuButton}" 
                            Click="BtnMyDonations_Click"/>
                    <Button Content="Мои кампании" Style="{StaticResource MenuButton}" 
                            Click="BtnMyCampaigns_Click"/>
                    <Button Content="Профиль" Style="{StaticResource MenuButton}" 
                            Click="BtnProfile_Click"/>

                    <!-- Кнопка Админ-панели (видна только Admin) -->
                    <Button x:Name="btnAdmin" 
                            Content="Админ-панель" 
                            Style="{StaticResource MenuButton}" 
                            Click="BtnAdmin_Click"
                            Visibility="Collapsed"/>

                    <!--<Button x:Name="btnTheme" 
                            Content="🌙 Тёмная тема" 
                            Style="{StaticResource MenuButton}" 
                            Click="BtnTheme_Click"/>-->
                </StackPanel>
                

                <!-- Выход -->
                <Button DockPanel.Dock="Bottom" 
                        Content="Выйти" 
                        Style="{StaticResource MenuButton}"
                        Margin="0,0,0,15"
                        Click="BtnLogout_Click"/>
            </DockPanel>
        </Border>

        <!-- ===== Правая часть (контент) ===== -->
        <Grid Grid.Column="1">
            <Frame x:Name="MainFrame" 
                   NavigationUIVisibility="Hidden" 
                   Background="White"/>
        </Grid>
    </Grid>
</Window>