<Window x:Class="Cursavayaup1.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему"
        Height="440" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BgPrimary}"
        FontFamily="{DynamicResource AppFont}">

    <Border Background="{DynamicResource BgSecondary}" Margin="30" Padding="28"
            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Платформа пожертвований"
                       FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,24"
                       Foreground="{DynamicResource TextPrimary}"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <TextBlock Text="Логин" Margin="0,0,0,5" Foreground="{DynamicResource TextSecondary}"/>
                <TextBox x:Name="txtUsername" Height="36" FontSize="14" Padding="8,5"
                         Background="{DynamicResource InputBg}"
                         Foreground="{DynamicResource TextPrimary}"
                         BorderBrush="{DynamicResource BorderColor}"
                         VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,20">
                <TextBlock Text="Пароль" Margin="0,0,0,5" Foreground="{DynamicResource TextSecondary}"/>
                <PasswordBox x:Name="txtPassword" Height="36" FontSize="14" Padding="8,5"
                             Background="{DynamicResource InputBg}"
                             Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource BorderColor}"
                             VerticalContentAlignment="Center"/>
            </StackPanel>

            <Button Grid.Row="3" Content="Войти" Style="{StaticResource PrimaryButton}"
                    Height="40" Click="BtnLogin_Click"/>

            <TextBlock Grid.Row="4" HorizontalAlignment="Center" Margin="0,18,0,0" FontSize="13"
                       Foreground="{DynamicResource TextSecondary}">
                <Run Text="Нет аккаунта? "/>
                <Hyperlink Click="BtnRegister_Click" Foreground="{DynamicResource Accent}">
                    Зарегистрироваться
                </Hyperlink>
            </TextBlock>
        </Grid>
    </Border>
</Window>