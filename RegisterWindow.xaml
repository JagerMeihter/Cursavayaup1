<Window x:Class="Cursavayaup1.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация"
        Height="560" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BgPrimary}"
        FontFamily="{DynamicResource AppFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="{DynamicResource BgSecondary}" Margin="24" Padding="24"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Регистрация" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,18"
                           Foreground="{DynamicResource TextPrimary}"/>

                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="Логин *" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBox x:Name="txtUsername" Height="34" Padding="8"
                             Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource BorderColor}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock Text="Email *" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBox x:Name="txtEmail" Height="34" Padding="8"
                             Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource BorderColor}"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,0,0,10">
                    <TextBlock Text="ФИО *" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBox x:Name="txtFullName" Height="34" Padding="8"
                             Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource BorderColor}"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,0,0,10">
                    <TextBlock Text="Телефон" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBox x:Name="txtPhone" Height="34" Padding="8"
                             Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource BorderColor}"/>
                </StackPanel>

                <StackPanel Grid.Row="5" Margin="0,0,0,10">
                    <TextBlock Text="Пароль *" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondary}"/>
                    <PasswordBox x:Name="txtPassword" Height="34" Padding="8"
                                 Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}"
                                 BorderBrush="{DynamicResource BorderColor}"/>
                </StackPanel>

                <StackPanel Grid.Row="6" Margin="0,0,0,18">
                    <TextBlock Text="Повтор пароля *" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondary}"/>
                    <PasswordBox x:Name="txtPasswordConfirm" Height="34" Padding="8"
                                 Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}"
                                 BorderBrush="{DynamicResource BorderColor}"/>
                </StackPanel>

                <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Зарегистрироваться" Style="{StaticResource PrimaryButton}"
                            Width="170" Click="BtnRegister_Click" Margin="0,0,10,0"/>
                    <Button Content="Назад" Width="100" Height="38"
                            Background="{DynamicResource TextSecondary}" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Click="BtnBack_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </ScrollViewer>
</Window>