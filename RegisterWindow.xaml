<Window x:Class="Cursavayaup1.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" 
        Height="560" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Регистрация" 
                       FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,20"
                       Foreground="#2C3E50"/>

            <!-- Логин -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="Логин *" Margin="0,0,0,4"/>
                <TextBox x:Name="txtUsername" Height="32" Padding="6"/>
            </StackPanel>

            <!-- Email -->
            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <TextBlock Text="Email *" Margin="0,0,0,4"/>
                <TextBox x:Name="txtEmail" Height="32" Padding="6"/>
            </StackPanel>

            <!-- ФИО -->
            <StackPanel Grid.Row="3" Margin="0,0,0,12">
                <TextBlock Text="ФИО *" Margin="0,0,0,4"/>
                <TextBox x:Name="txtFullName" Height="32" Padding="6"/>
            </StackPanel>

            <!-- Телефон -->
            <StackPanel Grid.Row="4" Margin="0,0,0,12">
                <TextBlock Text="Телефон" Margin="0,0,0,4"/>
                <TextBox x:Name="txtPhone" Height="32" Padding="6"/>
            </StackPanel>

            <!-- Пароль -->
            <StackPanel Grid.Row="5" Margin="0,0,0,12">
                <TextBlock Text="Пароль *" Margin="0,0,0,4"/>
                <PasswordBox x:Name="txtPassword" Height="32" Padding="6"/>
            </StackPanel>

            <!-- Повтор пароля -->
            <StackPanel Grid.Row="6" Margin="0,0,0,20">
                <TextBlock Text="Повтор пароля *" Margin="0,0,0,4"/>
                <PasswordBox x:Name="txtPasswordConfirm" Height="32" Padding="6"/>
            </StackPanel>

            <!-- Кнопки -->
            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Зарегистрироваться" Width="160" Height="38"
                        Background="#27AE60" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold" Cursor="Hand"
                        Click="BtnRegister_Click" Margin="0,0,10,0"/>

                <Button Content="Назад" Width="100" Height="38"
                        Background="#95A5A6" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="BtnBack_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>