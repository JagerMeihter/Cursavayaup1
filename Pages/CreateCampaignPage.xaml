<Page x:Class="Cursavayaup1.Pages.CreateCampaignPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Создать кампанию" Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30" MaxWidth="700">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Создание новой кампании" 
                       FontSize="24" FontWeight="Bold" Margin="0,0,0,25"
                       Foreground="#2C3E50"/>

            <!-- Название -->
            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <TextBlock Text="Название кампании *" Margin="0,0,0,5"/>
                <TextBox x:Name="txtTitle" Height="36" Padding="8"/>
            </StackPanel>

            <!-- Краткое описание -->
            <StackPanel Grid.Row="2" Margin="0,0,0,15">
                <TextBlock Text="Краткое описание (для карточки)" Margin="0,0,0,5"/>
                <TextBox x:Name="txtShortDescription" Height="36" Padding="8"/>
            </StackPanel>

            <!-- Полное описание -->
            <StackPanel Grid.Row="3" Margin="0,0,0,15">
                <TextBlock Text="Полное описание *" Margin="0,0,0,5"/>
                <TextBox x:Name="txtDescription" Height="120" Padding="8"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <!-- Цель и категория -->
            <Grid Grid.Row="4" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Целевая сумма (₽) *" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtGoalAmount" Height="36" Padding="8"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Категория" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbCategory" Height="36" Padding="8"/>
                </StackPanel>
            </Grid>

            <!-- Дата окончания -->
            <StackPanel Grid.Row="5" Margin="0,0,0,25">
                <TextBlock Text="Дата окончания" Margin="0,0,0,5"/>
                <DatePicker x:Name="dpEndDate" Height="36" Padding="8"/>
            </StackPanel>

            <!-- Кнопка -->
            <Button Grid.Row="6" Content="Создать кампанию" 
                    Width="200" Height="42" HorizontalAlignment="Left"
                    Background="#3498DB" Foreground="White" BorderThickness="0"
                    FontWeight="SemiBold" Cursor="Hand"
                    Click="BtnCreate_Click"/>
        </Grid>
    </ScrollViewer>
</Page>