<Page x:Class="Cursavayaup1.Pages.CampaignDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Детали кампании" Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Кнопка назад -->
            <Button Grid.Row="0" Content="← Назад к списку" 
                    HorizontalAlignment="Left" Padding="12,6"
                    Background="Transparent" BorderThickness="0"
                    Foreground="#3498DB" Cursor="Hand" FontSize="14"
                    Click="BtnBack_Click" Margin="0,0,0,15"/>

            <!-- Название -->
            <TextBlock Grid.Row="1" x:Name="txtTitle" 
                       FontSize="26" FontWeight="Bold" 
                       TextWrapping="Wrap" Foreground="#2C3E50"
                       Margin="0,0,0,10"/>

            <!-- Автор и категория -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock x:Name="txtCreator" Foreground="#7F8C8D" FontSize="14"/>
                <TextBlock Text="  •  " Foreground="#BDC3C7"/>
                <TextBlock x:Name="txtCategory" Foreground="#7F8C8D" FontSize="14"/>
                <TextBlock Text="  •  " Foreground="#BDC3C7"/>
                <TextBlock x:Name="txtStatus" FontSize="14" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Прогресс -->
            <Border Grid.Row="3" Background="#F8F9FA" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <ProgressBar x:Name="progressBar" Height="12" Minimum="0" Maximum="100"
                                     Background="#E9ECEF" Foreground="#27AE60"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="txtCollected" FontSize="18" FontWeight="Bold" Foreground="#27AE60"/>
                        <TextBlock Text=" из " FontSize="16" Foreground="#6C757D" VerticalAlignment="Bottom"/>
                        <TextBlock x:Name="txtGoal" FontSize="16" Foreground="#6C757D" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <TextBlock x:Name="txtPercent" FontSize="13" Foreground="#6C757D" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Описание -->
            <TextBlock Grid.Row="4" Text="Описание" FontSize="16" FontWeight="SemiBold" 
                       Margin="0,0,0,8" Foreground="#2C3E50"/>
            <TextBlock Grid.Row="5" x:Name="txtDescription" 
                       TextWrapping="Wrap" FontSize="14" LineHeight="22"
                       Foreground="#495057" Margin="0,0,0,25"/>

            <!-- Форма пожертвования -->
            <Border Grid.Row="6" Background="#E8F5E9" CornerRadius="8" Padding="20"
                    x:Name="donationPanel">
                <StackPanel>
                    <TextBlock Text="Сделать пожертвование" FontSize="16" FontWeight="SemiBold" 
                               Margin="0,0,0,12" Foreground="#2C3E50"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="txtAmount" Width="150" Height="36" 
                                 Padding="8,5" FontSize="15"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Text="  ₽" VerticalAlignment="Center" FontSize="16"/>
                    </StackPanel>

                    <TextBox x:Name="txtMessage" Height="70" 
                             Padding="8" FontSize="13"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,12"/>

                    <Button Content="Пожертвовать" Width="160" Height="38"
                            Background="#27AE60" Foreground="White" 
                            BorderThickness="0" FontWeight="SemiBold"
                            Cursor="Hand" HorizontalAlignment="Left"
                            Click="BtnDonate_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>