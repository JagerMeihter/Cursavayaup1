<Page x:Class="Cursavayaup1.Pages.CampaignDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Детали кампании"
      Background="{DynamicResource BgSecondary}"
      FontFamily="{DynamicResource AppFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Content="← Назад к списку"
                    HorizontalAlignment="Left" Padding="0,6"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource Accent}" Cursor="Hand" FontSize="14"
                    Click="BtnBack_Click" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="1" x:Name="txtTitle"
                       FontSize="24" FontWeight="Bold" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock x:Name="txtCreator" Foreground="{DynamicResource TextSecondary}" FontSize="13"/>
                <TextBlock Text="  ·  " Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock x:Name="txtCategory" Foreground="{DynamicResource TextSecondary}" FontSize="13"/>
                <TextBlock Text="  ·  " Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock x:Name="txtStatus" FontSize="13" FontWeight="SemiBold"/>
            </StackPanel>

            <Border Grid.Row="3" Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    CornerRadius="8" Padding="18" Margin="0,0,0,18">
                <StackPanel>
                    <ProgressBar x:Name="progressBar" Height="10" Minimum="0" Maximum="100"
                                 Background="{DynamicResource BorderColor}"
                                 Foreground="{DynamicResource Success}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="txtCollected" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource Accent}"/>
                        <TextBlock Text=" из " FontSize="15" Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Bottom"/>
                        <TextBlock x:Name="txtGoal" FontSize="15" Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <TextBlock x:Name="txtPercent" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="4" Text="Описание" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
            <TextBlock Grid.Row="5" x:Name="txtDescription" TextWrapping="Wrap" FontSize="14"
                       LineHeight="22" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,22"/>

            <Border Grid.Row="6" x:Name="donationPanel"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                    CornerRadius="8" Padding="18">
                <StackPanel>
                    <TextBlock Text="Сделать пожертвование" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="txtAmount" Width="140" Height="36" Padding="8,5" FontSize="15"
                                 Background="{DynamicResource InputBg}"
                                 Foreground="{DynamicResource TextPrimary}"
                                 BorderBrush="{DynamicResource BorderColor}"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Text="  ₽" VerticalAlignment="Center" FontSize="15"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>
                    <TextBox x:Name="txtMessage" Height="70" Padding="8" FontSize="13"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             Background="{DynamicResource InputBg}"
                             Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource BorderColor}"
                             VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>
                    <Button Content="Пожертвовать" Style="{StaticResource PrimaryButton}"
                            Width="150" HorizontalAlignment="Left" Click="BtnDonate_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>