<Page x:Class="Cursavayaup1.Pages.MyDonationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мои пожертвования"
      Background="{DynamicResource BgSecondary}"
      FontFamily="{DynamicResource AppFont}">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Мои пожертвования"
                   FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16"/>

        <DataGrid Grid.Row="1" x:Name="DonationsGrid"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                  Background="{DynamicResource CardBg}"
                  RowBackground="{DynamicResource CardBg}"
                  AlternatingRowBackground="{DynamicResource BgPrimary}"
                  Foreground="{DynamicResource TextPrimary}"
                  RowHeight="40" FontSize="13">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding DonationDate, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="140"/>
                <DataGridTextColumn Header="Кампания" Binding="{Binding CampaignTitle}" Width="*"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat=\{0:N0\} ₽}" Width="110"/>
                <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>