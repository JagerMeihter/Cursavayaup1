<Page x:Class="Cursavayaup1.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Профиль"
      Background="{DynamicResource BgSecondary}"
      FontFamily="{DynamicResource AppFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30" MaxWidth="480">
            <TextBlock Text="Мой профиль" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,20"/>

            <TextBlock Text="ФИО" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondary}"/>
            <TextBox x:Name="txtFullName" Height="34" Padding="8" Margin="0,0,0,12" IsReadOnly="True"
                     Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}"
                     BorderBrush="{DynamicResource BorderColor}"/>

            <TextBlock Text="Логин" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondary}"/>
            <TextBox x:Name="txtUsername" Height="34" Padding="8" Margin="0,0,0,12" IsReadOnly="True"
                     Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}"
                     BorderBrush="{DynamicResource BorderColor}"/>

            <TextBlock Text="Email" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondary}"/>
            <TextBox x:Name="txtEmail" Height="34" Padding="8" Margin="0,0,0,12" IsReadOnly="True"
                     Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}"
                     BorderBrush="{DynamicResource BorderColor}"/>

            <TextBlock Text="Телефон" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondary}"/>
            <TextBox x:Name="txtPhone" Height="34" Padding="8" Margin="0,0,0,12" IsReadOnly="True"
                     Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}"
                     BorderBrush="{DynamicResource BorderColor}"/>

            <TextBlock Text="Роль" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondary}"/>
            <TextBox x:Name="txtRole" Height="34" Padding="8" Margin="0,0,0,12" IsReadOnly="True"
                     Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}"
                     BorderBrush="{DynamicResource BorderColor}"/>

            <TextBlock Text="Дата регистрации" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondary}"/>
            <TextBox x:Name="txtCreatedAt" Height="34" Padding="8" Margin="0,0,0,12" IsReadOnly="True"
                     Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}"
                     BorderBrush="{DynamicResource BorderColor}"/>

            <TextBlock Text="Последний вход" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondary}"/>
            <TextBox x:Name="txtLastLogin" Height="34" Padding="8" Margin="0,0,0,20" IsReadOnly="True"
                     Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}"
                     BorderBrush="{DynamicResource BorderColor}"/>

            <Separator Margin="0,0,0,16"/>

            <TextBlock Text="Смена пароля" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

            <TextBlock Text="Текущий пароль" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondary}"/>
            <PasswordBox x:Name="txtCurrentPassword" Height="34" Padding="8" Margin="0,0,0,10"
                         Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}"
                         BorderBrush="{DynamicResource BorderColor}"/>

            <TextBlock Text="Новый пароль" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondary}"/>
            <PasswordBox x:Name="txtNewPassword" Height="34" Padding="8" Margin="0,0,0,10"
                         Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}"
                         BorderBrush="{DynamicResource BorderColor}"/>

            <TextBlock Text="Повтор нового пароля" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondary}"/>
            <PasswordBox x:Name="txtNewPasswordConfirm" Height="34" Padding="8" Margin="0,0,0,14"
                         Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextPrimary}"
                         BorderBrush="{DynamicResource BorderColor}"/>

            <Button Content="Сменить пароль" Style="{StaticResource PrimaryButton}"
                    Width="160" HorizontalAlignment="Left" Click="BtnChangePassword_Click"/>
        </StackPanel>
    </ScrollViewer>
</Page>