<Page x:Class="Cursavayaup1.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Профиль" Background="White">

    <Grid Margin="30" MaxWidth="500">
        <StackPanel>
            <TextBlock Text="Мой профиль" FontSize="24" FontWeight="Bold" 
                       Foreground="#2C3E50" Margin="0,0,0,25"/>

            <TextBlock Text="ФИО" Margin="0,0,0,5" Foreground="#555"/>
            <TextBox x:Name="txtFullName" Height="36" Padding="8" Margin="0,0,0,15" IsReadOnly="True"/>

            <TextBlock Text="Логин" Margin="0,0,0,5" Foreground="#555"/>
            <TextBox x:Name="txtUsername" Height="36" Padding="8" Margin="0,0,0,15" IsReadOnly="True"/>

            <TextBlock Text="Email" Margin="0,0,0,5" Foreground="#555"/>
            <TextBox x:Name="txtEmail" Height="36" Padding="8" Margin="0,0,0,15" IsReadOnly="True"/>

            <TextBlock Text="Телефон" Margin="0,0,0,5" Foreground="#555"/>
            <TextBox x:Name="txtPhone" Height="36" Padding="8" Margin="0,0,0,15" IsReadOnly="True"/>

            <TextBlock Text="Роль" Margin="0,0,0,5" Foreground="#555"/>
            <TextBox x:Name="txtRole" Height="36" Padding="8" Margin="0,0,0,15" IsReadOnly="True"/>

            <TextBlock Text="Дата регистрации" Margin="0,0,0,5" Foreground="#555"/>
            <TextBox x:Name="txtCreatedAt" Height="36" Padding="8" Margin="0,0,0,15" IsReadOnly="True"/>

            <TextBlock Text="Последний вход" Margin="0,0,0,5" Foreground="#555"/>
            <TextBox x:Name="txtLastLogin" Height="36" Padding="8" IsReadOnly="True"/>

            <Separator Margin="0,25,0,15"/>

            <TextBlock Text="Смена пароля" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <TextBlock Text="Текущий пароль" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtCurrentPassword" Height="36" Padding="8" Margin="0,0,0,12"/>

            <TextBlock Text="Новый пароль" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtNewPassword" Height="36" Padding="8" Margin="0,0,0,12"/>

            <TextBlock Text="Повтор нового пароля" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtNewPasswordConfirm" Height="36" Padding="8" Margin="0,0,0,15"/>

            <Button Content="Сменить пароль" Width="160" Height="36" HorizontalAlignment="Left"
                Background="#3498DB" Foreground="White" BorderThickness="0"
                Click="BtnChangePassword_Click"/>
        </StackPanel>
    </Grid>
</Page>