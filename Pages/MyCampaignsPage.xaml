<Page x:Class="Cursavayaup1.Pages.MyCampaignsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мои кампании" Background="White">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Мои кампании" 
                   FontSize="24" FontWeight="Bold" 
                   Foreground="#2C3E50" Margin="0,0,0,20"/>

        <DataGrid Grid.Row="1" x:Name="CampaignsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="0"
                  AlternatingRowBackground="#F8F9FA"
                  RowHeight="42"
                  FontSize="13"
                  MouseDoubleClick="CampaignsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Цель" Binding="{Binding GoalAmount, StringFormat=\{0:N0\} ₽}" Width="110"/>
                <DataGridTextColumn Header="Собрано" Binding="{Binding CurrentAmount, StringFormat=\{0:N0\} ₽}" Width="110"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Создана" Binding="{Binding CreatedAt, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>