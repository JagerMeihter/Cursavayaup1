<Page x:Class="Cursavayaup1.Pages.MyCampaignsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мои кампании"
      Background="{DynamicResource BgSecondary}"
      FontFamily="{DynamicResource AppFont}">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Мои кампании"
                   FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16"/>

        <DataGrid Grid.Row="1" x:Name="CampaignsGrid"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                  Background="{DynamicResource CardBg}"
                  RowBackground="{DynamicResource CardBg}"
                  AlternatingRowBackground="{DynamicResource BgPrimary}"
                  Foreground="{DynamicResource TextPrimary}"
                  RowHeight="42" FontSize="13"
                  MouseDoubleClick="CampaignsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Цель" Binding="{Binding GoalAmount, StringFormat=\{0:N0\} ₽}" Width="100"/>
                <DataGridTextColumn Header="Собрано" Binding="{Binding CurrentAmount, StringFormat=\{0:N0\} ₽}" Width="100"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="90"/>
                <DataGridTextColumn Header="Создана" Binding="{Binding CreatedAt, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>