<Page x:Class="Cursavayaup1.Pages.CampaignsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Все кампании"
      Background="{DynamicResource BgSecondary}"
      FontFamily="{DynamicResource AppFont}">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Все кампании"
                   FontSize="24" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,15"/>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <TextBox x:Name="txtSearch" Height="34" Padding="10,5"
                     Background="{DynamicResource InputBg}"
                     Foreground="{DynamicResource TextPrimary}"
                     BorderBrush="{DynamicResource BorderColor}"
                     VerticalContentAlignment="Center"
                     TextChanged="TxtSearch_TextChanged"/>
            <TextBlock x:Name="txtSearchPlaceholder" Text="Поиск по названию..."
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{DynamicResource TextSecondary}"
                       IsHitTestVisible="False"/>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CampaignsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="280" Margin="0,0,15,15"
                                Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="8" Padding="15" Cursor="Hand"
                                MouseLeftButtonUp="CampaignCard_Click">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.12"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Margin="0,0,0,8"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding ShortDescription}" FontSize="12"
                                           TextWrapping="Wrap" MaxHeight="40" Margin="0,0,0,10"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <ProgressBar Height="8" Minimum="0" Maximum="100"
                                             Value="{Binding ProgressPercent}"
                                             Background="{DynamicResource BorderColor}"
                                             Foreground="{DynamicResource Success}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding CurrentAmount, StringFormat={}{0:N0} ₽}"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text=" из " Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding GoalAmount, StringFormat={}{0:N0} ₽}"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}">
                                    <Run Text="{Binding DonationsCount}"/>
                                    <Run Text=" пожертвований"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>