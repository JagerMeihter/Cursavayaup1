<Page x:Class="Cursavayaup1.Pages.CampaignsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Все кампании"
      Background="White">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Все кампании" 
                   FontSize="24" FontWeight="Bold" 
                   Foreground="#2C3E50" Margin="0,0,0,15"/>

        <!-- Поиск -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBox x:Name="txtSearch" Width="300" Height="32" 
                     Padding="8,5" VerticalContentAlignment="Center"
                     TextChanged="TxtSearch_TextChanged"/>
            <TextBlock Text="  Поиск по названию..." VerticalAlignment="Center" 
                       Foreground="Gray" Margin="-290,0,0,0" IsHitTestVisible="False"
                       x:Name="txtSearchPlaceholder"/>
        </StackPanel>

        <!-- Список кампаний -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CampaignsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="280" Margin="0,0,15,15" 
                                Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                CornerRadius="8" Padding="15"
                                Cursor="Hand"
                                MouseLeftButtonUp="CampaignCard_Click">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
                            </Border.Effect>

                            <StackPanel>
                                <TextBlock Text="{Binding Title}" 
                                           FontSize="16" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Margin="0,0,0,8"
                                           Foreground="#2C3E50"/>

                                <TextBlock Text="{Binding ShortDescription}" 
                                           FontSize="13" TextWrapping="Wrap"
                                           Foreground="#7F8C8D" MaxHeight="40"
                                           Margin="0,0,0,10"/>

                                <!-- Прогресс -->
                                <Grid Margin="0,0,0,6">
                                    <ProgressBar Height="8" Minimum="0" Maximum="100"
                                                 Value="{Binding ProgressPercent}"
                                                 Background="#ECF0F1" Foreground="#27AE60"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding CurrentAmount, StringFormat={}{0:N0} ₽}" 
                                               FontWeight="SemiBold" Foreground="#27AE60"/>
                                    <TextBlock Text=" из " Foreground="Gray"/>
                                    <TextBlock Text="{Binding GoalAmount, StringFormat={}{0:N0} ₽}" 
                                               Foreground="Gray"/>
                                </StackPanel>

                                <TextBlock FontSize="12" Foreground="#95A5A6">
                                    <Run Text="{Binding DonationsCount}"/>
                                    <Run Text=" пожертвований • "/>
                                    <Run Text="{Binding CategoryName}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>